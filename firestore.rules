rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------
    function signedIn()   { return request.auth != null; }
    function tok()        { return request.auth.token; }
    function role()       { return tok().get('role', ''); }
    function myOrg()      { return tok().get('orgId', ''); }
    function isVerified() { return signedIn() && tok().get('verified', false) == true; }
    function membershipPath(orgId) {
      return /databases/$(db)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }
    function hasActiveMembership(orgId, expectedRole) {
      return signedIn()
        && orgId is string
        && orgId.size() > 0
        && exists(membershipPath(orgId))
        && get(membershipPath(orgId)).data.status == 'active'
        && get(membershipPath(orgId)).data.role == expectedRole;
    }
    function isClinician() {
      return isVerified()
        && role() in ['doctor', 'pharmacist']
        && hasActiveMembership(myOrg(), role());
    }
    function isLabTech() {
      return isVerified()
        && role() == 'lab_tech'
        && hasActiveMembership(myOrg(), 'lab_tech');
    }
    function isOrgAdmin(o) {
      return isVerified()
        && role() == 'org_admin'
        && myOrg() == o
        && hasActiveMembership(o, 'org_admin');
    }
    function isPlatformAdmin() {
      return signedIn() && role() == 'platform_admin' && isVerified();
    }
    function isSelf(uid)  { return signedIn() && request.auth.uid == uid; }
    function onlyKeys(keys)    { return request.resource.data.keys().hasOnly(keys); }
    function hasAllKeys(keys)  { return request.resource.data.keys().hasAll(keys); }
    function immutable(fields) {
      return request.resource.data.diff(resource.data).unchangedKeys().hasAll(fields);
    }
    function notAffected(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function actorRoleNow() {
      return role() == '' ? 'patient' : role();
    }

    function patientDoc(pid) {
      return get(/databases/$(db)/documents/patients/$(pid));
    }
    function ownsPatient(pid) {
      return signedIn() && patientDoc(pid).data.ownerUid == request.auth.uid;
    }
    function consentPath(pid) {
      return /databases/$(db)/documents/patients/$(pid)/consents/$(request.auth.uid);
    }
    function organizationConsentPath(pid) {
      return /databases/$(db)/documents/patients/$(pid)/consents/$(myOrg());
    }
    // Clinical scopes additionally require a verified clinician token.
    function hasConsent(pid, scope) {
      return signedIn()
        && exists(consentPath(pid))
        && get(consentPath(pid)).data.active == true
        && get(consentPath(pid)).data.expiresAt > request.time
        && scope in get(consentPath(pid)).data.scope;
    }
    function hasOrganizationConsent(pid, scope) {
      return isClinician()
        && exists(organizationConsentPath(pid))
        && get(organizationConsentPath(pid)).data.active == true
        && get(organizationConsentPath(pid)).data.expiresAt > request.time
        && scope in get(organizationConsentPath(pid)).data.scope;
    }
    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) || signedIn();
      allow delete: if false; // DPDP erasure via Cloud Function

      match /prescriptions/{prescriptionId} {
        allow read, write: if signedIn();
      }

      match /vcfFiles/{fileId} {
        allow read, write: if isSelf(uid) || signedIn();
      }
      match /consents/{consentId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && consentId == 'privacy_notice'
          && onlyKeys(['accepted', 'noticeVersion', 'createdAt'])
          && hasAllKeys(['accepted', 'noticeVersion', 'createdAt'])
          && request.resource.data.accepted == true
          && request.resource.data.noticeVersion == '1.1'
          && request.resource.data.createdAt == request.time;
        allow update: if isSelf(uid)
          && consentId == 'privacy_notice'
          && resource.data.accepted == true
          && resource.data.noticeVersion == '1.0'
          && request.resource.data.accepted == true
          && request.resource.data.noticeVersion == '1.1'
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['noticeVersion', 'updatedAt']);
        allow delete: if false;
      }

      match /organizationInvitations/{orgId} {
        allow read, write: if false;
      }

      match /directoryRequests/{organizationId} {
        allow get, list: if isSelf(uid);
        allow create: if isSelf(uid)
          && onlyKeys([
            'organizationId', 'organizationName', 'patientUid',
            'patientName', 'status', 'requestedAt'
          ])
          && hasAllKeys([
            'organizationId', 'organizationName', 'patientUid',
            'patientName', 'status', 'requestedAt'
          ])
          && request.resource.data.organizationId == organizationId
          && request.resource.data.patientUid == uid
          && request.resource.data.patientName
             == get(/databases/$(db)/documents/users/$(uid)).data.displayName
          && get(/databases/$(db)/documents/users/$(uid)).data.accountType
             == 'patient'
          && request.resource.data.organizationName
             == get(/databases/$(db)/documents/organizationDirectory/$(organizationId)).data.name
          && request.resource.data.status == 'directory_request_pending'
          && request.resource.data.requestedAt == request.time
          && getAfter(
            /databases/$(db)/documents/organizationDirectory/$(organizationId)/requests/$(uid)
          ).data.status == request.resource.data.status;
        allow update: if isSelf(organizationId)
          && resource.data.patientUid == uid
          && resource.data.status == 'directory_request_pending'
          && request.resource.data.status in [
            'directory_request_acknowledged', 'directory_request_declined'
          ]
          && request.resource.data.respondedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'respondedAt'])
          && getAfter(
            /databases/$(db)/documents/organizationDirectory/$(organizationId)/requests/$(uid)
          ).data.status == request.resource.data.status
          && getAfter(
            /databases/$(db)/documents/organizationDirectory/$(organizationId)/requests/$(uid)
          ).data.respondedAt == request.time;
        allow delete: if false;
      }

      // ---------- synced derived reports (existing B2C history) ----------
      // Derived calls only. Raw VCF content must never be written here.
      match /reports/{id} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && onlyKeys([
            'drug', 'gene', 'diplotype', 'phenotype', 'tier',
            'ruleSetVersion', 'explanationText', 'profileId', 'createdAt'
          ])
          && hasAllKeys([
            'drug', 'gene', 'phenotype', 'tier', 'ruleSetVersion', 'createdAt'
          ])
          && request.resource.data.tier in [
            'safe', 'caution', 'high_risk', 'contraindicated',
            'no_guideline', 'insufficient_data'
          ]
          && request.resource.data.get('explanationText', '').size() < 5000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isSelf(uid); // user-controlled history deletion (DPDP)

        match /chat/{messageId} {
          allow read, write: if isSelf(uid);
        }
      }
    }

    // ---------- verified professional directory ----------
    match /providers/{uid} {
      allow get, list: if signedIn() && resource.data.verified == true;
      allow write: if false;
    }

    // Public-safe directory entries: self-registered listings are owner-bound;
    // provisioned organizations use the trusted organization claim.
    match /organizationDirectory/{orgId} {
      allow get, list: if signedIn()
        && resource.data.active == true
        && resource.data.keys().hasOnly([
          'organizationId', 'name', 'city', 'normalizedName', 'active',
          'selfRegistered', 'updatedAt'
        ]);
      allow create, update: if (
          isSelf(orgId)
          && onlyKeys([
            'organizationId', 'name', 'city', 'normalizedName', 'active',
            'selfRegistered', 'updatedAt'
          ])
          && hasAllKeys([
            'organizationId', 'name', 'city', 'normalizedName', 'active',
            'selfRegistered', 'updatedAt'
          ])
          && request.resource.data.organizationId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 120
          && request.resource.data.city is string
          && request.resource.data.city.size() > 0
          && request.resource.data.city.size() <= 100
          && request.resource.data.normalizedName is string
          && request.resource.data.normalizedName.size() >= 2
          && request.resource.data.active == true
          && request.resource.data.selfRegistered == true
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.accountType
             == 'organization'
          && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.organizationName
             == request.resource.data.name
          && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.city
             == request.resource.data.city
        ) || (
          isClinician()
          && myOrg() == orgId
          && onlyKeys([
            'organizationId', 'name', 'city', 'normalizedName', 'active',
            'updatedAt'
          ])
          && hasAllKeys([
            'organizationId', 'name', 'city', 'normalizedName', 'active',
            'updatedAt'
          ])
          && request.resource.data.organizationId == orgId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 120
          && request.resource.data.city is string
          && request.resource.data.city.size() <= 100
          && request.resource.data.normalizedName is string
          && request.resource.data.active == true
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(db)/documents/organizations/$(orgId)).data.name
             == request.resource.data.name
          && get(/databases/$(db)/documents/organizations/$(orgId)).data.get('city', '')
             == request.resource.data.city
        );
      allow delete: if false;

        match /requests/{patientUid} {
          allow get: if isSelf(patientUid) || isSelf(orgId);
          allow list: if isSelf(orgId);
          allow create: if isSelf(patientUid)
            && orgId != patientUid
            && onlyKeys([
              'organizationId', 'organizationName', 'patientUid',
              'patientName', 'status', 'requestedAt'
            ])
            && hasAllKeys([
              'organizationId', 'organizationName', 'patientUid',
              'patientName', 'status', 'requestedAt'
            ])
            && request.resource.data.organizationId == orgId
            && request.resource.data.patientUid == patientUid
            && request.resource.data.patientName
               == get(/databases/$(db)/documents/users/$(patientUid)).data.displayName
            && get(/databases/$(db)/documents/users/$(patientUid)).data.accountType
               == 'patient'
            && request.resource.data.organizationName
               == get(/databases/$(db)/documents/organizationDirectory/$(orgId)).data.name
            && get(/databases/$(db)/documents/organizationDirectory/$(orgId)).data.active == true
            && get(/databases/$(db)/documents/organizationDirectory/$(orgId)).data.selfRegistered == true
            && request.resource.data.status == 'directory_request_pending'
            && request.resource.data.requestedAt == request.time
            && getAfter(
              /databases/$(db)/documents/users/$(patientUid)/directoryRequests/$(orgId)
            ).data.status == request.resource.data.status;
          allow update: if isSelf(orgId)
            && resource.data.patientUid == patientUid
            && resource.data.status == 'directory_request_pending'
            && request.resource.data.status in [
              'directory_request_acknowledged', 'directory_request_declined'
            ]
            && request.resource.data.respondedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt'])
            && getAfter(
              /databases/$(db)/documents/users/$(patientUid)/directoryRequests/$(orgId)
            ).data.status == request.resource.data.status
            && getAfter(
              /databases/$(db)/documents/users/$(patientUid)/directoryRequests/$(orgId)
            ).data.respondedAt == request.time;
          allow delete: if false;
        }
    }

    // Organization metadata and patient linking are scoped to the trusted org claim.
    match /organizations/{orgId} {
      allow get: if isClinician() && myOrg() == orgId;
      allow list, create, update, delete: if false;

      match /members/{uid} {
        allow read: if isSelf(uid) || isOrgAdmin(orgId) || isPlatformAdmin();
        allow write: if false;
      }

      match /patientInvitations/{patientUid} {
        allow read, write: if false;
      }

      match /patientLinks/{patientId} {
        allow read, write: if false;
      }
    }

    // ---------- orgs ----------
    match /orgs/{orgId} {
      allow read: if signedIn() && (myOrg() == orgId || isPlatformAdmin());
      allow write: if false;

      match /members/{uid} {
        allow read: if isSelf(uid) || isOrgAdmin(orgId) || isPlatformAdmin();
        allow write: if false;
      }
    }

    // ---------- patients ----------
    match /patients/{pid} {
      allow read, write: if signedIn();
      allow delete: if false;

      match /consents/{grantee} {
        allow read, write: if signedIn();
      }

      match /genomicProfiles/{profileId} {
        allow read, write: if signedIn();
      }

      match /prescriptionDrafts/{draftId} {
        allow read, write: if signedIn();
      }

      match /prescriptions/{prescriptionId} {
        allow read, write: if signedIn();
      }
      match /checks/{id} {
        allow read: if ownsPatient(pid) || (isClinician()
          && (hasConsent(pid, 'read_checks')
              || hasOrganizationConsent(pid, 'read_checks')));

        allow create: if (ownsPatient(pid) || (isClinician()
          && (hasConsent(pid, 'write_checks')
              || hasOrganizationConsent(pid, 'write_checks'))))
          && onlyKeys([
            'drug', 'gene', 'phenotype', 'tier', 'ruleSetVersion',
            'actorUid', 'actorRole', 'createdAt', 'confirmedByClinician'
          ])
          && hasAllKeys([
            'drug', 'gene', 'phenotype', 'tier', 'ruleSetVersion',
            'actorUid', 'actorRole', 'createdAt', 'confirmedByClinician'
          ])
          && request.resource.data.tier in [
            'safe', 'caution', 'high_risk', 'contraindicated',
            'no_guideline', 'insufficient_data'
          ]
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorRole == actorRoleNow()
          && (request.resource.data.confirmedByClinician == false || isClinician())
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      match /notes/{id} {
        allow read: if ownsPatient(pid) || (isClinician()
          && (hasConsent(pid, 'read_notes')
              || hasOrganizationConsent(pid, 'read_notes')));

        allow create: if isClinician()
          && (hasConsent(pid, 'write_notes')
              || hasOrganizationConsent(pid, 'write_notes'))
          && onlyKeys([
            'authorUid', 'authorRole', 'body', 'revisionOf', 'createdAt'
          ])
          && hasAllKeys(['authorUid', 'authorRole', 'body', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole == role()
          && request.resource.data.body.size() < 20000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // ---------- lab orders ----------
    match /labOrders/{id} {
      allow read: if signedIn() && (
          (isLabTech() && resource.data.orgId == myOrg())
          || isOrgAdmin(resource.data.orgId)
          || ownsPatient(resource.data.patientId));

      allow create: if isLabTech()
          && onlyKeys(['orgId', 'patientId', 'status', 'createdBy', 'createdAt'])
          && hasAllKeys(['orgId', 'patientId', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.orgId == myOrg()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'created'
          && request.resource.data.createdAt == request.time
          && hasConsent(request.resource.data.patientId, 'lab_order');

      allow update: if isLabTech() && resource.data.orgId == myOrg()
          && immutable(['orgId', 'patientId', 'createdBy', 'createdAt'])
          && request.resource.data.status in [
            'created', 'received', 'processing', 'published', 'qc_failed'
          ];

      allow delete: if false;
    }

    // ---------- rule sets (clients read-only) ----------
    match /ruleSets/{version} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- audit (append-only, identity-bound) ----------
    // Best practice: write audit server-side via Cloud Function. This client path
    // is bound to the caller's own token so it cannot be spoofed.
    match /auditEvents/{id} {
      allow create: if signedIn()
        && onlyKeys([
          'actorUid', 'actorRole', 'orgId', 'action', 'patientRef',
          'ruleSetVersion', 'deviceId', 'createdAt', 'meta'
        ])
        && hasAllKeys(['actorUid', 'actorRole', 'action', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == actorRoleNow()
        && request.resource.data.get('orgId', '') == myOrg()
        && request.resource.data.createdAt == request.time;

      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.actorUid == request.auth.uid)
        || isOrgAdmin(resource.data.get('orgId', ''));

      allow update, delete: if false;
    }

    // ---------- prescriptions & audit ----------
    match /prescriptions/{prescriptionId} {
      allow read, write: if signedIn();
    }

    match /auditLogs/{id} {
      allow read, write: if signedIn();
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
