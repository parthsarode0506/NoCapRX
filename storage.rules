rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- helpers ----------
    function signedIn()    { return request.auth != null; }
    function tok()         { return request.auth.token; }
    function role()        { return tok().get('role', ''); }
    function isSelf(uid)   { return signedIn() && request.auth.uid == uid; }
    function isPlatformAdmin() { return signedIn() && role() == 'platform_admin'; }

    // Max file sizes
    function maxDocSize()  { return 10 * 1024 * 1024; }

    // ---------- exported reports (PDF) ----------
    // Users can store generated PDF reports for sharing with clinicians.
    match /reports/{uid}/{reportId}/{fileName} {
      allow read: if isSelf(uid) || isPlatformAdmin();
      allow create: if isSelf(uid)
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < maxDocSize();
      allow update, delete: if isSelf(uid);
    }

    // ---------- profile photos ----------
    match /profiles/{uid}/{fileName} {
      allow read: if isSelf(uid) || isPlatformAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5 MB
      allow delete: if isSelf(uid);
    }

    // ---------- default deny ----------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
